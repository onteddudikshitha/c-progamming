        scanf("%s",s[i].name);
        printf("enter marks:");
        scanf("%d",&s[i].marks);
    }
    for(i=0;i<3;i++)
    {
        printf("id=%d",s[i].id);
        printf("name=%s",s[i].name);
        printf("marks=%d",s[i].marks);
    }

}
