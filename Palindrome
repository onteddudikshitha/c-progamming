#include<stdio.h>
#include<string.h>
int main()
{
    int i,same=1,l;
    char str[90];
    printf("enter string:");
    scanf("%s",str);
    l=strlen(str);
    for(i=0;i<l/2;i++)
    {
        if(str[i]!=str[l-i-1])
        {
            same=0;
            break;
        }
    }
    if(same==1)
    {
        printf("string is palindrome");
    }
    else
    {
        printf("string is not pslindrome");
    }
}
