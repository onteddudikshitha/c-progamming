#include<stdio.h>
int main()
{
    int i,a[10],n;
    int max=0;
    printf("enter n value:");
    scanf("%d",&n);
    for(i=0;i<n;i++)
    {
        scanf("%d",&a[i]);
    }
    max=a[0];
    for(i=1;i<n;i++)
    { 
        if(a[i]>max)
        {
            max=a[i];
        }
        
    }
    printf("largest=%d",max);
    

}
