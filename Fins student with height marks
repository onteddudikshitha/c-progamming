#include<stdio.h>
#include<string.h>
struct student
{
    int  id;
    char name[30];
    int marks;
};
int main()
{
    struct student s[3];
    int i,max=0,index;
    for(i=0;i<3;i++)
    {
        printf("enter details\n");
        printf("enter id:");
        scanf("%d",&s[i].id);
        printf("enter name:");
        scanf("%s",s[i].name);
        printf("enter marks:");
        scanf("%d",&s[i].marks);
    }
    max=s[0].marks;
    index=0;
    for(i=0;i<3;i++)
    {
        if(s[i].marks>max)
        {
            max=s[i].marks;
            index=i;
        }
    }
    printf("id=%d",s[index].id);
    printf("name=%s",s[index].name);
    printf("marks=%d",s[index].marks);
}
