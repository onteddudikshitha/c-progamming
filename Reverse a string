#include<stdio.h>
#include<string.h>
int main()
{
    char  str1[15],temp;
    int i,l;
    printf("enter string:");
    scanf("%s",str1);
    l=strlen(str1);
    for(i=0;i<l/2;i++)
    {
        temp=str1[i];
        str1[i]=str1[l-i-1];
        str1[l-i-1]=temp;  
    }
    
    printf("%s",str1);
}
