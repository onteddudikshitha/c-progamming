#include<stdio.h>
int main()
{
    int i,a[10],n;
    int temp=0;
    printf("enter n value:");
    scanf("%d",&n);
    for(i=0;i<n;i++)
    {
        scanf("%d",&a[i]);
    }
    
    for(i=0;i<n/2;i++)
    { 
        
        temp=a[i];
        a[i]=a[n-i-1];
        a[n-i-1]=temp;
        
    }
    for(i=0;i<n;i++)
    {
        printf("%d",a[i]);
    }
}
